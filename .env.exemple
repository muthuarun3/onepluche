# Copier en .env (jamais versionné) et adapter.
# Trois connexions, une par rôle PostgreSQL (voir sql/roles.sql).

# Migrations uniquement (propriétaire des schémas)
DEMO_DB_PROPRIETAIRE_URL=postgresql://demo_proprietaire:changer-moi@localhost:5432/demographie
# Imports (écriture sur ingest et stat)
DEMO_DB_IMPORT_URL=postgresql://demo_import:changer-moi@localhost:5432/demographie
# Application web et API (lecture seule sur le schéma api)
DEMO_DB_LECTURE_URL=postgresql://demo_lecture:changer-moi@localhost:5432/demographie

# Dossier des fichiers bruts téléchargés (nommés par empreinte SHA-256)
DEMO_DONNEES_BRUTES=./donnees-brutes
