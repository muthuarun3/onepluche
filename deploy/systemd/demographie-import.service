[Unit]
Description=Démographie France : import des nouvelles publications (INSEE)
After=postgresql.service network-online.target
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=demographie
Group=demographie
WorkingDirectory=/opt/demographie/app
EnvironmentFile=/etc/demographie/env
# Un fichier déjà importé est reconnu à son empreinte : relancer ne coûte rien.
ExecStart=/opt/demographie/app/.venv/bin/demo importer estimations

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/demographie/brut
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=768M
