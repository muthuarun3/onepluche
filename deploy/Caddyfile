# Modèle : __DOMAINE__ est remplacé par deploy/installer.sh.
# Certificat HTTPS obtenu et renouvelé automatiquement par Caddy.
__DOMAINE__ {
	encode zstd gzip

	# Accès réservé au petit cercle : lien secret géré par l'application
	# (DEMO_CLE_ACCES dans /etc/demographie/env, voir src/demographie/acces.py).

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy 127.0.0.1:8000

	log {
		output file /var/log/caddy/demographie.log {
			roll_keep 10
		}
	}
}
